# ./run.sh loads .env. Direct codenames invocation uses exported variables only.
GEMMA_DEVICE=cpu
GEMMA_MODEL_ID=google/embeddinggemma-2
GEMMA_CACHE_DIR=.cache
GEMMA_BATCH_SIZE=32
# GEMMA_EMBEDDINGS_FILE=.cache/gemma_embeddings.npz
# GEMMA_REVISION=<pinned model commit>
# GEMMA_BOARD_WORDS=/absolute/path/to/board_words.csv
# GEMMA_VOCABULARY=/absolute/path/to/clue_words.csv
# CODENAMES_MODE=demo
PORT=8000
